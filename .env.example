# Salin jadi .env.local (sudah masuk .gitignore lewat pola *.local) dan
# sesuaikan. SEMUA variabel di sini opsional -- kalau tidak diisi, aplikasi
# memakai default produksi, persis seperti perilaku sebelum env var ini ada.
#
# PENTING untuk development: tanpa VITE_API_BASE_URL, `npm run dev` menembak
# database PRODUKSI.

# Backend Siarpi. Untuk dev lokal biasanya http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Aplikasi utama tujuan tombol "Masuk ke Dashboard Utama" (alur handoff).
# Untuk dev lokal biasanya http://localhost:3000
VITE_MAIN_APP_URL=http://localhost:3000

# Port dev server dan WebSocket HMR. Keduanya harus selalu sama.
VITE_DEV_PORT=8084
