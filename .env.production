# Dipakai OTOMATIS setiap `vite build` (mode production), termasuk build di
# dashboard Cloudflare dan `wrangler deploy`. Tidak perlu .env lain.
#
# JANGAN taruh secret di sini -- semua nilai di bawah ini publik by design
# (terlihat di bundle JS). Secret hanya milik server (backend .env).
#
# CATATAN: jangan pindahkan ini ke `vars` wrangler.jsonc -- vars wrangler
# adalah variabel RUNTIME Worker dan TIDAK diteruskan ke build Vite, jadi
# VITE_* tidak akan sampai ke bundle.

# Backend production.
VITE_API_BASE_URL=https://api.siarpi.com

# OAuth Client ID Google (publik). Sama dengan GOOGLE_CLIENT_ID backend.
VITE_GOOGLE_CLIENT_ID=234459820032-2oh5j013s1ta7shdu4cg94f98493l9sv.apps.googleusercontent.com

# Aplikasi utama tujuan tombol "Masuk ke Dashboard Utama".
VITE_MAIN_APP_URL=https://app.siarpi.com
